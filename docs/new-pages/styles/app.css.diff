+  font-size: 12.5px; font-weight: 600; letter-spacing: 0.18em;
+  text-transform: uppercase;
+  color: rgba(255,255,255,0.85);
+}
+.eyebrow-rule::before{
+  content:""; width: 34px; height: 2px;
+  background: var(--blue-pale);
+  flex-shrink: 0;
+}
+
+.hero-full h1{
+  font-family: var(--font-display);
+  font-weight: 700;
+  font-size: clamp(40px, 4.6vw, 60px);
+  line-height: 1.08;
+  letter-spacing: -0.015em;
+  color: var(--white);
+  margin: 24px 0 20px;
+}
+/* Inline, not display:block — "without the stress." should wrap mid-line. */
+.hero-full h1 em{
+  font-style: italic;
+  color: var(--blue-pale);
+}
+.hero-full p{
+  color: rgba(255,255,255,0.92);
+  font-size: 18px; line-height: 1.6;
+  max-width: 500px;
+  margin: 0 0 36px;
+}

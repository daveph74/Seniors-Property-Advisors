APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Turns itself on when APP_ENV=production — see config/session.php. Leave it unset locally: a
# secure-only cookie is never sent over http://localhost, so sign-in would fail with no visible
# reason. Set it to false only to serve production over plain HTTP, which you should not.
# SESSION_SECURE_COOKIE=true
#
# Deployment values live in .env.production.example, and `php artisan security:check --production`
# checks them rather than trusting that this comment was read.

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=floci
AWS_SECRET_ACCESS_KEY=floci
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=spa-media
AWS_ENDPOINT=http://localhost:4566
AWS_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"

# Google Places API (New) — server-side only, never exposed to the browser.
# Needs the "Places API (New)" enabled and should be IP-restricted to the server.
# Leave blank and the suburb field simply falls back to free text.
GOOGLE_PLACES_API_KEY=

# The CMS listens for "an enquiry has arrived" so an open inbox updates without a reload. The
# message carries no personal data — the screen refetches through /cms/enquiries — so the risk of
# running it is small, but it does need a process: `php artisan reverb:start`, and a queue worker,
# since the event is queued. Without either the admin behaves exactly as it did before: the inbox
# updates when somebody looks at it. Generate your own credentials per environment.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
# https in production, which also makes the browser use wss:// and the content policy follow.
REVERB_SCHEME=http

# There is deliberately no VITE_REVERB_* here. Those are baked into the assets at build time, so a
# build carrying one environment's credentials, served by another, opened a socket its own content
# policy forbade. `app/Cms/Realtime.php` sends these from the server that drew the page instead.

# The proxy that terminates TLS in front of this, as a comma-separated list of addresses or CIDRs.
# Empty is correct locally. On a server it is what makes X-Forwarded-For and -Proto believable, and
# both a rate limit keyed on a visitor and the HSTS header depend on that. `*` trusts whoever
# connects, which is only safe while PHP-FPM cannot be reached except through the proxy.
TRUSTED_PROXIES=

# Production environment.
#
# Copy to .env on the server, fill in the blanks, then run:
#
#   php artisan key:generate
#   php artisan migrate --force
#   php artisan security:check --production
#
# The last one answers this file back to you. It exits non-zero if anything here is wrong, so a
# deploy step can gate on it rather than trusting that somebody read the comments.

APP_NAME="Seniors Property Advisors"
APP_ENV=production
APP_KEY=
# Absent, not false. The default is already false, and a line saying `true` is the one that gets
# left behind after debugging a deploy at two in the morning.
# APP_DEBUG=false
APP_URL=https://seniorspropertyadvisors.com.au

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_AU

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# `debug` here would write every query to disk on a live site.
LOG_LEVEL=error

# SQLite is fine for this site's volume, but the file must sit outside the web root and be backed
# up with the media bucket — it is the only copy of every page, article and enquiry.
DB_CONNECTION=sqlite
# DB_DATABASE=/var/www/shared/database.sqlite

SESSION_DRIVER=database
# How long an editor stays signed in. 120 minutes is Laravel's default and a deliberate choice
# either way — shorter is safer, longer is kinder to somebody writing a long article.
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Not needed: `config/session.php` turns this on by itself when APP_ENV=production. Set it to false
# only if this is somehow served over plain HTTP, and understand what that means before you do.
# SESSION_SECURE_COOKIE=true

# Server-side rendering. Without it the delivered HTML is an empty div, and anything that does not
# run JavaScript — Bing, LinkedIn, Slack, every AI crawler — reads a blank page.
#
# Off to begin with, deliberately. It needs a second process (`inertia:start-ssr`) under a
# supervisor, and until that exists turning this on buys nothing: every page would attempt the
# renderer, fail, and draw itself in the browser exactly as it does now. Measured cost of that
# state is about 1ms a page, so it is not harmful — it is simply a feature that is not running
# while claiming to be, which is the failure this whole section is about.
#
# Turn it on in the same change that adds the service, then prove it:
#     curl -s https://your-domain/how-it-works | grep -c '<h1'
# One means it is working. Zero means it fell back, and the page still looks perfect.
INERTIA_SSR_ENABLED=false
INERTIA_SSR_URL=http://127.0.0.1:13714
FILESYSTEM_DISK=s3
# `file`, not `database`. Every throttled request counts in the cache, and counting in SQLite takes a
# database-wide write lock to do it — so the busiest moment is the one that serialises every other
# request. On a single server a file is both faster and less to keep alive.
CACHE_STORE=file

# The proxy terminating TLS, by address or CIDR, or `*` if only the proxy can reach this application.
# Nothing works properly without it and nothing says so: every visitor looks like the proxy, so six
# enquiries a minute becomes six for the whole internet, and the request never looks secure to PHP, so
# the HSTS header is never sent. `security:check --production` fails on an empty value.
TRUSTED_PROXIES=

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@seniorspropertyadvisors.com.au"
MAIL_FROM_NAME="${APP_NAME}"

# The media library. The bucket holds everything an editor uploads and is served through this
# application's /media route, so it does not need to be public — the route reads it, not the browser.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-2
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
# AWS_ENDPOINT is deliberately absent, and has to stay absent. It exists in `.env.example` to point a
# developer's machine at floci, the S3 emulator `docker-compose.yml` runs on :4566 — a container that
# is never deployed. Copied to a server it sends every upload into that emulator's local volume: no
# versioning, no backup, gone with `docker compose down -v`, and the site looks perfectly well the
# whole time because the disk is configured not to throw. `security:check --production` fails on a
# local address here, and on blank credentials, for the same reason.
VITE_APP_NAME="${APP_NAME}"

# Places API (New). Restrict it by IP to this server in the Google console — an unrestricted key on
# a public endpoint is somebody else's billing. Leave blank and the suburb field falls back to free
# text, which is a supported state, not a broken one.
GOOGLE_PLACES_API_KEY=

+/* ===================== Hero (full-bleed variant) ===================== */
+/* Photo runs edge to edge for one viewport; copy sits on the empty left of the frame.
+   Everything is scoped under .hero-full so the boxed hero above is untouched. */
+.hero-full{
+  position: relative;
+  display: flex; align-items: center;
+  padding: 72px 0;
+  overflow: hidden;
+  min-height: calc(100vh - 126px);      /* 42px topbar + 84px nav */
+  min-height: calc(100svh - 126px);     /* no jump when the mobile URL bar hides */
+}
+.hero-full-bg{
+  position: absolute; inset: 0;
+  background-image: url('/images/full_bg.png');
+  background-size: cover;
+  background-position: center right;
+  z-index: 0;
+}
+/* Navy scrim, heaviest over the copy. Brand shading rather than a grey wash. The stops
+   are set by measurement, not taste: the bright window behind the middle of the frame is
+   near-white, so the scrim has to still be ~0.74 where the lead paragraph ends for 18px
+   text to clear 4.5:1. It clears to nothing before it reaches the people. */
+.hero-full-bg::after{
+  content:""; position:absolute; inset: 0;
+  background: linear-gradient(
+    100deg,
+    rgba(13,34,63,0.92) 0%,
+    rgba(13,34,63,0.88) 26%,
+    rgba(13,34,63,0.74) 44%,
+    rgba(13,34,63,0.40) 60%,
+    rgba(13,34,63,0.12) 78%,
+    rgba(13,34,63,0.00) 92%
+  );
+}
+/* width:100% — as a flex item the container would otherwise shrink to its content and
+   the auto margins would centre it, pulling the copy off the page gutter. */
+.hero-full .container{ position: relative; z-index: 1; width: 100%; }
+.hero-full-copy{ max-width: 580px; }
+
+.eyebrow-rule{
